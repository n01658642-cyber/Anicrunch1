<?xml version="1.0" encoding="utf-8"?>
<!--
    Cast belongs to the mobile flavor only. The options provider is read reflectively by Play
    Services at startup, and MediaTransferReceiver is what lets Android 13+ System UI move the
    session between the phone and a Cast route — both are meaningless without the Cast stack,
    which the TV flavor does not build against.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Held only while the phone is browsing for a television to sign in. NsdManager itself needs
        no permission, but several vendors stop delivering multicast to a dozing Wi-Fi radio, which
        makes mDNS discovery work on a desk and fail on a sofa. Mobile-only: the television
        advertises, it never browses.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application>
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="androidx.media3.cast.DefaultCastOptionsProvider" />

        <receiver
            android:name="androidx.mediarouter.media.MediaTransferReceiver"
            android:exported="true" />

        <!--
            The app icon follows the theme's accent preset (IconVariants.kt). A launcher icon cannot
            be recoloured at runtime, so each colour is its own alias of MainActivity and exactly one
            is enabled at a time. Only enabled, never renamed: an alias name is what a pinned
            home-screen icon points at. Icons generated by scripts/generate_icon_variants.py.
        -->
        <activity-alias
            android:name="com.anilili.IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity="com.anilili.MainActivity">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.anilili.IconMonochrome"
